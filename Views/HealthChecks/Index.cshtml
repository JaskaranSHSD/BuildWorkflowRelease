@model IEnumerable<BuildWorkflowRelease.Models.Entities.ApiHealthCheck>
@{
    ViewData["Title"] = "API Health Checks";
}
@if (TempData["LastResult"] != null) {
    <div class="alert alert-info">@TempData["LastResult"]</div>
}
<div class="gc-card">
<p><a asp-action="Create" class="btn btn-primary">New Health Check</a></p>
<div class="table-responsive">
<table class="table">
    <thead><tr><th>Name</th><th>URL</th><th>Interval</th><th>Status</th><th>Last Checked</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model) {
        <tr>
            <td>@c.Name</td>
            <td>@c.Url</td>
            <td>@(c.IntervalMinutes) min</td>
            <td>@(c.LastCheckedAt == null ? "Never" : (c.LastHealthy ? "Healthy" : "Unhealthy"))</td>
            <td>@c.LastCheckedAt</td>
            <td>
                <form asp-action="Run" asp-route-id="@c.Id" method="post" style="display:inline">
                    <button class="btn btn-sm btn-success">Run</button>
                </form>
                <a asp-action="Logs" asp-route-id="@c.Id" class="btn btn-sm btn-secondary">Logs</a>
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-secondary">Edit</a>
                <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline">
                    <button class="btn btn-sm btn-danger" onclick="return confirm('Delete?')">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
</div>