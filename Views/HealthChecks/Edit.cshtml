@model BuildWorkflowRelease.Models.Entities.ApiHealthCheck
@{
    ViewData["Title"] = "Edit Health Check";
}
<div class="gc-card">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">URL to check</label><input asp-for="Url" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Expected Response (contains)</label><input asp-for="ExpectedResponse" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Interval (minutes)</label><input asp-for="IntervalMinutes" class="form-control" /></div>
    <div class="form-check mb-2"><input asp-for="Enabled" class="form-check-input" /><label class="form-check-label">Enabled</label></div>
    <div class="mb-3"><label class="form-label">Restart URL</label><input asp-for="RestartUrl" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Notify URL</label><input asp-for="NotifyUrl" class="form-control" /></div>
    <div class="mb-3">
        <label class="form-label">SFTP Target (optional)</label>
        <select asp-for="SftpConfigId" class="form-control" asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(ViewBag.Sftp, "Id", "Name"))">
            <option value="">-- none --</option>
        </select>
    </div>
    <div class="mb-3"><label class="form-label">Failure Commands on SFTP host (comma-separated)</label><textarea asp-for="FailureCommands" class="form-control" rows="3"></textarea></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
</div>