@model BuildWorkflowRelease.Controllers.BuildRunViewModel
@{
    ViewData["Title"] = "Build Logs - " + Model.Name;
}
<div class="gc-card">
    <h3>Build Logs: @Model.Name</h3>
    <p><strong>Status:</strong> @(Model.Success ? "Success" : "Failed / Unknown")</p>
    @if (!string.IsNullOrEmpty(Model.ErrorMessage)) {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
</div>
<div class="gc-card">
    <h4>Terminal Output</h4>
    <div style="background:#111;color:#eee;padding:10px;font-family:monospace;max-height:600px;overflow:auto;">
    @foreach (var l in Model.Logs) { <div>@l</div> }
    </div>
</div>
<p><a asp-action="Index" class="btn btn-secondary">Back to Builds</a></p>